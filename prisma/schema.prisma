generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model DailyEntry {
  id         Int      @id @default(autoincrement())
  date       DateTime @unique
  relDone    Boolean  @default(false)
  workDone   Boolean  @default(false)
  reflection String?
  createdAt  DateTime @default(now())
}

model Insight {
  id        Int      @id @default(autoincrement())
  text      String
  source    String?
  createdAt DateTime @default(now())
}
